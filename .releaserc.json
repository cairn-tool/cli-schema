{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nAll notable changes to this project are documented here. This file is generated by [semantic-release](https://github.com/semantic-release/semantic-release) — do not edit it by hand."
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": true,
        "pkgRoot": "packages/cli-schema"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": true,
        "pkgRoot": "packages/cli-schema-commander"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm pkg set dependencies.@cairn-tool/cli-schema=${nextRelease.version} --workspace=@cairn-tool/cli-schema-commander",
        "publishCmd": "dotnet pack dotnet/CliSchema.slnx -c Release -p:Version=${nextRelease.version} -o dist-nuget && dotnet nuget push \"dist-nuget/*.nupkg\" --source https://api.nuget.org/v3/index.json --api-key \"$NUGET_API_KEY\" --skip-duplicate"
      }
    ],
    "@semantic-release/github",
    [
      "@semantic-release/git",
      {
        "assets": [
          "package-lock.json",
          "packages/cli-schema/package.json",
          "packages/cli-schema-commander/package.json",
          "CHANGELOG.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
